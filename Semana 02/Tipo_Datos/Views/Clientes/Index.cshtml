@model IEnumerable<Tipo_Datos.Models.Entidades.ClientesModel>
@{
    ViewData["Title"] = "Ventas - Lista de Clientes";
    //crear clientes el fondo es azul
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Lista de Clientes</h1>
<p>
    <a asp-action="Nuevo" class="btn btn-primary">Crear Cliente</a>
</p>

<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group">
        <label for="cedulaRUC" class="mr-2">Buscar por RUC:</label>
        <input type="text" name="cedulaRUC" class="form-control mr-2" placeholder="Ingrese RUC o Cédula" value="@ViewBag.RucBuscado" />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary ml-2">Limpiar</a>
    </div>
</form>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning">@ViewBag.Mensaje</div>
}

<table class="table table-responsive table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Nombre Cliente</th>
            <th>RUC</th>
            <th>Telefono</th>
            <th>Email</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@i</td>
                <td>@Html.DisplayFor(modelItem => item.Nombres)</td>
                <td>@Html.DisplayFor(modelItem => item.Cedula_RUC)</td>
                <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-outline-success">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-outline-danger">Eliminar</a>
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>